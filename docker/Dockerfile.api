FROM node:22-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@latest

# ─── Install dependencies ──────────────────────────
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile

# ─── Build ─────────────────────────────────────────
FROM deps AS builder
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN pnpm --filter @vt/api build

# ─── Runner ────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Install FFmpeg for spokesperson video transcoding
RUN apk add --no-cache ffmpeg

RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 apiuser

# Copy compiled output and dependencies
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/node_modules   ./node_modules
COPY --from=builder /app/prisma         ./prisma

# Persistent uploads directory
RUN mkdir -p uploads \
 && chown -R apiuser:nodejs /app

USER apiuser
EXPOSE 4000

# Run migrations then start the server
CMD ["sh", "-c", "node node_modules/.bin/prisma migrate deploy && node dist/server.js"]
