# ─── Database ───────────────────────────────────
DB_NAME=virtualtour
DB_USER=vtadmin
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_PORT=5432
DATABASE_URL=postgresql://vtadmin:CHANGE_ME_strong_password_here@localhost:5432/virtualtour

# ─── JWT ────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_64_chars_random_string_here_use_openssl_rand_hex_32
JWT_EXPIRES_IN=24h

# ─── Admin Seed ─────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ─── Server ─────────────────────────────────────
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── File Upload ────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=524288000

# ─── Frontend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_UPLOAD_URL=http://localhost:4000/uploads

# ─── Production Domain (uncomment for deploy) ───
DOMAIN=360-tour1-api.vercel.app
