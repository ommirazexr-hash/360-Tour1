# ──────────────────────────────────────────────────────────
# VirtualTour Platform — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/virtualtour?schema=public"

# ─── API Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── JWT Authentication ───────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Admin Seed ───────────────────────────────────────────
# Used when running: pnpm --filter @vt/api db:seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@company.com

# ─── File Storage ─────────────────────────────────────────
# Local storage (default)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# AWS S3 (uncomment when ready)
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BUCKET_NAME=your-bucket-name
# AWS_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# Cloudflare R2 (uncomment when ready)
# STORAGE_PROVIDER=r2
# CF_ACCOUNT_ID=your-account-id
# CF_R2_ACCESS_KEY=your-r2-access-key
# CF_R2_SECRET_KEY=your-r2-secret-key
# CF_R2_BUCKET=your-bucket-name
# CF_R2_PUBLIC_URL=https://pub.r2.dev/your-bucket

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
